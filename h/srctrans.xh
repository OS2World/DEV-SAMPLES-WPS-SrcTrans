/*
 * -- This emitter treats Method Tokens as Thunks by default.
 * -- Use the sc modifier "nothunks" to change this default
 */
#undef somresolve_
#define somresolve_(obj,mToken) ((somMethodProc*)((void)obj, mToken))

/*
 * -- The C++ Wrapper Class for SrcTransient
 */
class SrcTransient : public WPTransient
{
public:

// SrcTransient::new creates the class object if necessary, and then uses somNewNoInit
// to allocate memory and create the object. Initialization is in ctors.
void *operator new(size_t)
{
   if (!_SrcTransient) SrcTransientNewClass(SrcTransient_MajorVersion,SrcTransient_MinorVersion);
   return (void*)
      SOM_Resolve(_SrcTransient,SOMClass,somNewNoInit)
         ((SOMClass *)((void*)_SrcTransient));
}

// SrcTransient::delete uses somDestruct.
void operator delete(void * obj)
{
   if (obj && *(void**)obj) {
      SOM_Resolve(obj,SOMObject,somFree)
         ((SOMObject*)obj);
   }
}

SrcTransient& operator=(SrcTransient& fromObj)
{
   this->somDefaultAssign(0,(SOMObject*)((void*)&fromObj));
   return *this;
}

SrcTransient()
{
   if (*(void**)this != 
       ((somParentMtabStructPtr)
        (SrcTransientCClassData.parentMtab))->mtab)
      return;
   ((SOMObject*)((void*)this))->somDefaultInit(0);
}

SrcTransient(SrcTransient* fromObj)
{
   if (*(void**)this != 
       ((somParentMtabStructPtr)
        (SrcTransientCClassData.parentMtab))->mtab)
      return;
   ((SOMObject*)((void*)this))->somDefaultCopyInit(0,((SOMObject*)((void*)fromObj)));
}

#ifdef __IBMCPP__
#pragma info(nocnv,nopar)
#endif
SrcTransient(const SrcTransient* fromObj)
{
   if (*(void**)this != 
       ((somParentMtabStructPtr)
        (SrcTransientCClassData.parentMtab))->mtab)
      return;
   ((SOMObject*)((void*)this))->somDefaultConstCopyInit(0,((SOMObject*)((void*)fromObj)));
}
#ifdef __IBMCPP__
#pragma info(restore)
#endif


