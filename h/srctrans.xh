/*
 * -- This emitter treats Method Tokens as Thunks by default.
 * -- Use the sc modifier "nothunks" to change this default
 */
#undef somresolve_
#define somresolve_(obj,mToken) ((somMethodProc*)((void)obj, mToken))

/*
 * -- The C++ Wrapper Class for M_SrcTransient
 */
class M_SrcTransient : public M_WPTransient
{
public:

// M_SrcTransient::new creates the class object if necessary, and then uses somNewNoInit
// to allocate memory and create the object. Initialization is in ctors.
void *operator new(size_t)
{
   if (!_M_SrcTransient) M_SrcTransientNewClass(M_SrcTransient_MajorVersion,M_SrcTransient_MinorVersion);
   return (void*)
      SOM_Resolve(_M_SrcTransient,SOMClass,somNewNoInit)
         ((SOMClass *)((void*)_M_SrcTransient));
}

// M_SrcTransient::delete uses somDestruct.
void operator delete(void * obj)
{
   if (obj && *(void**)obj) {
      SOM_Resolve(obj,SOMObject,somFree)
         ((SOMObject*)obj);
   }
}

M_SrcTransient& operator=(M_SrcTransient& fromObj)
{
   this->somDefaultAssign(0,(SOMObject*)((void*)&fromObj));
   return *this;
}

M_SrcTransient()
{
   if (*(void**)this != 
       ((somParentMtabStructPtr)
        (M_SrcTransientCClassData.parentMtab))->mtab)
      return;
   ((SOMObject*)((void*)this))->somDefaultInit(0);
}

M_SrcTransient(M_SrcTransient* fromObj)
{
   if (*(void**)this != 
       ((somParentMtabStructPtr)
        (M_SrcTransientCClassData.parentMtab))->mtab)
      return;
   ((SOMObject*)((void*)this))->somDefaultCopyInit(0,((SOMObject*)((void*)fromObj)));
}

#ifdef __IBMCPP__
#pragma info(nocnv,nopar)
#endif
M_SrcTransient(const M_SrcTransient* fromObj)
{
   if (*(void**)this != 
       ((somParentMtabStructPtr)
        (M_SrcTransientCClassData.parentMtab))->mtab)
      return;
   ((SOMObject*)((void*)this))->somDefaultConstCopyInit(0,((SOMObject*)((void*)fromObj)));
}
#ifdef __IBMCPP__
#pragma info(restore)
#endif


